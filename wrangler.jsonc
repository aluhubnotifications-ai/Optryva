{
  // Single full-stack Worker: serves the built client (client/dist) as static
  // assets and the API (/api/*) from server/src/worker.ts. Same origin → no CORS,
  // same-site auth cookie.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optryva",
  "main": "server/src/worker.ts",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: Buffer/process/crypto for jsonwebtoken, bcryptjs, the Anthropic
  // & Supabase SDKs — and (date >= 2025-04-01) populates process.env from secrets.
  "compatibility_flags": ["nodejs_compat"],

  // Resolve the "@/..." path alias when esbuild bundles the Worker.
  "alias": { "@": "./server/src" },

  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Send API calls to the Worker; everything else is served from client/dist.
    "run_worker_first": ["/api/*"]
  },

  // Weekly honesty calibration (Mon 03:00 UTC). Handled by worker.ts scheduled().
  "triggers": { "crons": ["0 3 * * 1"] },

  "observability": { "enabled": true }
}
