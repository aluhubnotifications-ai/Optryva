# Copy to .env and fill in.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Google OAuth (Continue with Google). All three are REQUIRED or /oauth/google
# returns oauth_not_configured. Create an OAuth 2.0 Client ID (Web application)
# in Google Cloud Console and add GOOGLE_REDIRECT_URI as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console, e.g.
# local:  http://localhost:4000/api/oauth/google/callback
# prod:   https://<api-domain>/api/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# AI — optional. If unset, AI routes fall back to the deterministic engine + canned text.
ANTHROPIC_API_KEY=
# Mistral (alternative provider for assessment generation). Uses mistral-large-latest
# by default (the smartest model); override with MISTRAL_MODEL if desired.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_VISION_MODEL=pixtral-large-latest

# Supabase REST (Project Settings → API). service_role is admin-level — server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
